<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vaultdrop.xml" />
        <!-- The note index. Names and paths only, but a diary's filenames are its dates. -->
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vaultdrop.xml" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
